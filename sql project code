-- Display all customers
SELECT * FROM Customer;

-- Display all products
SELECT * FROM Product;

-- Display products costing more than 5000
SELECT * FROM Product
WHERE Price > 5000;

-- Display products in Electronics category
SELECT * FROM Product
WHERE Category = 'Electronics';

-- Display customer orders
SELECT * FROM Orders;

-- Display customers along with their orders
SELECT 
    Customer.Customer_Name,
    Orders.Order_ID,
    Orders.Order_Date,
    Orders.Total_Amount
FROM Customer
JOIN Orders
ON Customer.Customer_ID = Orders.Customer_ID;

-- Display order details with product names
SELECT
    Orders.Order_ID,
    Product.Product_Name,
    Order_Item.Quantity,
    Order_Item.Price
FROM Orders
JOIN Order_Item
ON Orders.Order_ID = Order_Item.Order_ID
JOIN Product
ON Order_Item.Product_ID = Product.Product_ID;

-- Find the total number of products
SELECT COUNT(*) AS Total_Products
FROM Product;

-- Find the average product price
SELECT AVG(Price) AS Average_Price
FROM Product;

-- Find the most expensive product
SELECT MAX(Price) AS Highest_Price
FROM Product;

-- Find total sales
SELECT SUM(Total_Amount) AS Total_Sales
FROM Orders;

-- Update product stock
UPDATE Product
SET Stock = Stock - 1
WHERE Product_ID = 101;

-- Change customer city
UPDATE Customer
SET City = 'Kakinada'
WHERE Customer_ID = 1;

-- Display paid payments
SELECT * FROM Payment
WHERE Payment_Status = 'Paid';

-- Create a view for order details
CREATE VIEW Order_Details AS
SELECT
    Orders.Order_ID,
    Customer.Customer_Name,
    Product.Product_Name,
    Order_Item.Quantity,
    Order_Item.Price,
    Orders.Order_Date
FROM Orders
JOIN Customer
ON Orders.Customer_ID = Customer.Customer_ID
JOIN Order_Item
ON Orders.Order_ID = Order_Item.Order_ID
JOIN Product
ON Order_Item.Product_ID = Product.Product_ID;

-- Display the view
SELECT * FROM Order_Details;
